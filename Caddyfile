{
    # Optional: your email for Let's Encrypt notifications
    email {$EMAIL:no-reply@example.com}
}

# The domain handled by this server
{$DOMAIN:localhost} {
    # Compress responses
    encode gzip
    root * /usr/share/caddy

    # 1. API - highest priority
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # 2. Admin Panel - preserve /admin prefix for React Router basename
    handle /admin* {
        reverse_proxy admin_panel:80
    }

    # 3. Static files for the main frontend (avatars, downloads)
    handle /ws* {
        reverse_proxy backend:8000
    }
    handle /avatars/* {
        reverse_proxy backend:8000
    }
    handle /files/download/* {
        reverse_proxy backend:8000
    }

    # 4. Main Frontend SPA fallback
    handle {
        file_server
        try_files {path} /index.html
    }
}
